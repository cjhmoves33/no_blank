{
  "name": "@no-blank/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=built --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@no-blank/ball-motion": "workspace:*",
    "@no-blank/shared": "workspace:*",
    "fastify": "^5.12.8",
    "three": "catalog:"
  },
  "devDependencies": {
    "@no-blank/eslint-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "@types/ws": "^8.18.2",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
