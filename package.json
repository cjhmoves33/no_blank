{
  "name": "no-blank",
  "private": true,
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @no-blank/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @no-blank/shared build && pnpm -r test",
    "lint:fix": "pnpm -r lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @no-blank/server db:generate",
    "db:migrate": "pnpm --filter @no-blank/server db:migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "knip": "6.46.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.10.1"
  }
}
